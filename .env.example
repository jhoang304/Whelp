# No need for DATABASE_URL to be set if developing from within a devcontainer

# Required. The app refuses to boot without one. Generate your own:
#     python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
DATABASE_URL=sqlite:///dev.db
SCHEMA=whelp_schema

# Which deployment this is: development (default) or production. Production
# addresses the SCHEMA above, forces https, and marks the session cookie
# Secure + SameSite=Strict. Set APP_ENV=production on the deployed service.
APP_ENV=development

# Log every SQL statement. Development only, and off unless you ask for it.
# SQLALCHEMY_ECHO=1

# AWS S3 for photo uploads (restaurant photos and profile pictures).
# Leave these blank locally and the app falls back to pasting image URLs.
S3_BUCKET=
S3_KEY=
S3_SECRET=
