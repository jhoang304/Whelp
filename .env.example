# No need for DATABASE_URL to be set if developing from within a devcontainer

# Required. The app refuses to boot without one. Generate your own:
#     python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
DATABASE_URL=sqlite:///dev.db
SCHEMA=whelp_schema

# Which deployment this is: development (default) or production. Production
# addresses the SCHEMA above, forces https, and marks the session cookie
# Secure + SameSite=Strict. Set APP_ENV=production on the deployed service.
APP_ENV=development

# Log every SQL statement. Development only, and off unless you ask for it.
# SQLALCHEMY_ECHO=1

# Where the login/signup rate limit is counted. In-process by default, which
# gives each worker its own allowance. Redis needs its client as well:
#     pip install "flask-limiter[redis]"
# RATELIMIT_STORAGE_URI=redis://localhost:6379

# Reverse proxies in front of the app, whose X-Forwarded-For can be trusted.
# 1 in production (Render), 0 here, where nothing proxies.
# TRUSTED_PROXY_HOPS=0

# Sign in with Google. Leave these blank and the app offers no Google
# button. To turn it on, in Google Cloud Console (console.cloud.google.com):
#   1. Make a project, and under "Google Auth Platform" set up the consent
#      screen: an app name, a support email, and the scopes openid, email
#      and profile.
#   2. Under Clients, create a "Web application" client. Its authorized
#      redirect URIs are where Google sends people back to:
#          http://localhost:5000/api/auth/google/callback   (flask run)
#          http://localhost:3000/api/auth/google/callback   (npm start)
#          https://<your-site>/api/auth/google/callback      (deployed)
#   3. Put its client ID and secret here, and on the deployed service.
# While the consent screen is in "Testing", only the test users it lists can
# sign in; publish it to let anyone.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email, for "Forgot your password?". Leave these blank here and the reset
# email is written to the flask log instead, link and all. In production,
# without them nobody is offered a reset. To send for real, with Resend
# (resend.com):
#   1. Add a domain you own under Domains, and the DNS records it shows you.
#   2. Create an API key with sending access.
#   3. MAIL_FROM is an address on that domain; it needn't be a real mailbox.
# PUBLIC_URL is where the site is, for the link: required in production.
RESEND_API_KEY=
MAIL_FROM=Whelp <noreply@your-domain.com>
PUBLIC_URL=

# AWS S3 for photo uploads (restaurant photos and profile pictures).
# Leave these blank locally and the app falls back to pasting image URLs.
S3_BUCKET=
S3_KEY=
S3_SECRET=
